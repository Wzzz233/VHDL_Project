# Build the board executable with the RK3568 SDK runtime.
# This standalone driver does not link GStreamer or DRM, so it deliberately uses
# the container toolchain runtime instead of the SDK Debian sysroot.


CROSS_COMPILE ?= aarch64-linux-gnu-
RKNN_RUNTIME_DIR ?= /home/hjf/SDK/external/rknpu2/runtime/Linux/librknn_api
RKNN_INC_DIR ?= $(RKNN_RUNTIME_DIR)/include
RKNN_LIB_DIR ?= $(RKNN_RUNTIME_DIR)/aarch64

CC := $(CROSS_COMPILE)gcc
CFLAGS := -Wall -Wextra -Werror -O2 -std=c11 -I. -I.. -I$(RKNN_INC_DIR)
LDFLAGS := -L$(RKNN_LIB_DIR) -lrknnrt -lm

cplus-rk3568-driver: cplus_rk3568_driver.c cplus_rknn.c cplus_rknn.h cplus_engine.c cplus_core.h ../pcie_fpga_dma.h
	$(CC) $(CFLAGS) -o $@ cplus_rk3568_driver.c cplus_rknn.c cplus_engine.c $(LDFLAGS)

.PHONY: cplus-rk3568-driver
